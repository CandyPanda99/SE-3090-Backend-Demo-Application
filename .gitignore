# =============================================================================
#  .gitignore - what must NEVER be committed
# =============================================================================
#  Two rules decide almost everything below.
#
#  1. IF A BUILD CAN REGENERATE IT, IT DOES NOT BELONG IN GIT.
#     bin/ and obj/ are tens of megabytes here and are rebuilt by `dotnet build`
#     in seconds. Committing them bloats history forever - git keeps every
#     version of every binary - and produces merge conflicts on files no human
#     ever edits.
#
#  2. IF LEAKING IT WOULD HURT, IT DEFINITELY DOES NOT BELONG IN GIT.
#     Deleting a secret in a later commit does NOT remove it from history:
#     anyone who clones the repo can still `git log -p` it back out. The only
#     real fix is rotating the credential, so the goal is never to commit it.
#
#  WHAT IS DELIBERATELY *NOT* IGNORED
#     Data/Migrations/     EF Core migrations and the model snapshot are source
#                          code - the schema's version history. A fresh clone
#                          cannot build its database without them.
#     appsettings*.json    Committed on purpose. They hold configuration, and
#                          their credentials are clearly-labelled placeholders.
#                          Real secrets belong in user-secrets or environment
#                          variables (see the Secrets section below).
#     docker-compose.yml   Infrastructure as code.
# =============================================================================


# -----------------------------------------------------------------------------
# .NET build output - regenerated by `dotnet build` / `dotnet publish`
# -----------------------------------------------------------------------------
**/bin/
**/obj/
**/out/
**/publish/
artifacts/
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Bb]uild[Ll]og.*

# Compiled binaries. Redundant with bin/ and obj/ above, but catches a stray
# copy left anywhere else in the tree.
#   NOTE: if you ever deliberately vendor a third-party DLL outside bin/,
#   add it with `git add -f path/to/lib.dll`.
*.dll
*.exe
*.pdb
*.so
*.dylib
*.a
*.lib
*.o

# MSBuild
*.binlog
msbuild.log
msbuild.err
msbuild.wrn
*.tlog
project.lock.json
project.fragment.lock.json


# -----------------------------------------------------------------------------
# Secrets, credentials and local environment - the rule-2 files
# -----------------------------------------------------------------------------
#  The real user-secrets store lives OUTSIDE the repo, under
#  ~/.microsoft/usersecrets/<UserSecretsId>/, which is exactly why
#  `dotnet user-secrets set "Jwt:Key" "..."` is the safe way to hold a local
#  secret. The patterns here catch the copies people make by hand.
.env
.env.*
!.env.example
**/*.env
**/secrets.json
**/appsettings.Local.json
**/appsettings.*.local.json
secrets/

# Certificates and private keys
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.p7b
*.snk

# Cloud / deployment credentials
*.publishsettings
*.pubxml
*.pubxml.user
PublishProfiles/
.azure/
*.azurePubxml


# -----------------------------------------------------------------------------
# Local databases - never commit a database file
# -----------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf
*.ndf
*.bak
*.dump


# -----------------------------------------------------------------------------
# Visual Studio
# -----------------------------------------------------------------------------
.vs/
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.sln.ide/
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.cachefile
*.ncrunch*
_NCrunch_*
.*crunch*.local.xml


# -----------------------------------------------------------------------------
# Visual Studio Code
# -----------------------------------------------------------------------------
#  Most of .vscode is per-developer, but a few files are genuine project config
#  worth sharing - so ignore the folder, then re-include those by name.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/*.code-snippets
.history/
*.code-workspace


# -----------------------------------------------------------------------------
# JetBrains Rider / ReSharper
# -----------------------------------------------------------------------------
.idea/
*.sln.iml
*.DotSettings.user
_ReSharper*/
*.[Rr]e[Ss]harper
.JustCode
*.dotCover


# -----------------------------------------------------------------------------
# Other editors
# -----------------------------------------------------------------------------
*.swp
*.swo
*~
.*.sw?
.\#*
\#*\#
.ionide/
.fake/


# -----------------------------------------------------------------------------
# Tests, coverage and benchmarking
# -----------------------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Tt]ests/
*.trx
*.coverage
*.coveragexml
*.gcov
coverage*.json
coverage*.xml
coverage*.info
coverage*.cobertura.xml
TestResults/
BenchmarkDotNet.Artifacts/
.sonarqube/


# -----------------------------------------------------------------------------
# NuGet
# -----------------------------------------------------------------------------
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
**/packages/*
!**/packages/build/
.nuget/
nuget.exe


# -----------------------------------------------------------------------------
# Node / front-end tooling (in case a client app is added later)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp.*
**/wwwroot/dist/
**/wwwroot/lib/


# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
#  docker-compose.yml IS committed - it is infrastructure as code. The override
#  file is the documented place for per-developer tweaks, so it is not.
docker-compose.override.yml
docker-compose.*.local.yml


# -----------------------------------------------------------------------------
# Logs, temp files and crash dumps
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.orig
*.rej
*.swp.bak
*.dmp
*.mdmp
*.stackdump
crash.log


# -----------------------------------------------------------------------------
# Archives - usually an accidentally-committed build artefact
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z


# -----------------------------------------------------------------------------
# AI / assistant tooling
# -----------------------------------------------------------------------------
#  .claude/settings.json is shared project config; settings.local.json is
#  personal (it records which commands you approved) and is not.
.claude/settings.local.json
.aider*
.cursorignore


# -----------------------------------------------------------------------------
# Operating-system noise
# -----------------------------------------------------------------------------
# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*
