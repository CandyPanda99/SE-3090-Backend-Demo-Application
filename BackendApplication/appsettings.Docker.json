{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "BackendApplication": "Information"
    }
  },

  "Database": {
    "MinPoolSize": 5,
    "MaxPoolSize": 50,
    "DbContextPoolSize": 128,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,

    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },

  "EnableApiDocs": true
}
