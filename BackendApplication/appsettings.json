{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "BackendApplication": "Information"
    }
  },

  "AllowedHosts": "*",

  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=tasksdb;Username=tasksuser;Password=taskspass",

    "MinPoolSize": 5,
    "MaxPoolSize": 50,
    "ConnectionTimeoutSeconds": 15,
    "ConnectionIdleLifetimeSeconds": 300,
    "ConnectionLifetimeSeconds": 1800,
    "CommandTimeoutSeconds": 30,

    "DbContextPoolSize": 128,

    "MaxRetryCount": 3,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },

  "Jwt": {
    "Key": "CHANGE-ME-this-development-only-signing-key-must-be-at-least-32-chars",
    "Issuer": "BackendApplication.TasksApi",
    "Audience": "BackendApplication.TasksClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 0
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },

  "EnableApiDocs": false
}
